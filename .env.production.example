# Copy this file to .env.production and fill in real values before running
# docker compose. Keep .env.production out of version control (already
# gitignored via the .env* rule).

# --- PostgreSQL (used by both the db and app services) ---
POSTGRES_USER=hrapp
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=hrapp_db

# --- App ---
# Random secret used to sign session tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-this-to-a-long-random-string

# The real URL users reach this app at (used in password-reset emails and
# as the Google OAuth redirect base) — must match what's registered as an
# authorized redirect URI in Google Cloud Console.
APP_BASE_URL=http://your-internal-server:3000

# --- SMTP (for password-reset / notification emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Google OAuth (Google Sheet import via a private account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
